# =============================================================================
# LLM Provider Configuration (choose ONE)
# =============================================================================

# Option 1: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-5.2

# Option 2: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-5

# Provider selection
LLM_PROVIDER=anthropic  # openai, anthropic, or ollama

# =============================================================================
# Query Planner (uses a cheap model for intent classification)
# =============================================================================
# PLANNER_MODEL=claude-haiku-4-5

# =============================================================================
# Answer LLM sampling parameters
# =============================================================================
LLM_TEMPERATURE=0.5   # 0.0 = deterministic, 1.0 = creative
LLM_TOP_P=1.0         # Nucleus sampling: 1.0 = off, 0.9 = mild, 0.7 = tight

# =============================================================================
# Retrieval & indexing
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=10
ENABLE_RERANKING=1

# =============================================================================
# Qdrant vector database
# =============================================================================
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                              # only needed for Qdrant Cloud
QDRANT_COLLECTION_PRIMARY=supermicro_primary
QDRANT_COLLECTION_MANUAL=supermicro_manual

# =============================================================================
# AWS deployment (used by scripts/aws_push_ecr.sh)
# =============================================================================
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# APP_NAME=supermicro-rag
# REPO=supermicro-rag
