# =============================================================================
# LLM Provider Configuration (choose ONE)
# =============================================================================

# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic Claude (recommended for professional tone)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-opus-4-5  # Default: Opus 4.5 (most capable)

# Optional: Pinecone (if using Pinecone vector store)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment

# Optional: Weaviate (if using Weaviate)
# WEAVIATE_API_KEY=your_weaviate_api_key_here
# WEAVIATE_URL=your_weaviate_url

# Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=openai  # Options: openai, anthropic, ollama
LLM_MODEL=gpt-5.2    # Only used for OpenAI; Anthropic uses ANTHROPIC_MODEL
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=15

# Retrieval settings
# Set to 0 to disable cross-encoder reranking (faster but less accurate)
ENABLE_RERANKING=1

# FAISS memory mapping (reduces RAM usage for large indexes)
FAISS_MMAP=1

# --- AWS deployment (ECR + App Runner) ---
# Used by scripts/aws_push_ecr.sh
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1
# ECR_REPO=supermicro-rag
# IMAGE_TAG=latest
# Set USE_BUILDX=1 to use docker buildx (optional)
